+++ b/06_programs/sn100_host/lis_business/original_lis_download_codec.h
@@ -0,0 +1,22 @@
+#ifndef SN100_ORIGINAL_LIS_DOWNLOAD_CODEC_H
+#define SN100_ORIGINAL_LIS_DOWNLOAD_CODEC_H
+
+#include "original_lis_download_types.h"
+
+namespace Sn100Lis
+{
+// 本地解析预算，不是原协议字段上限；超限明确拒绝，不截断后报解码成功。
+constexpr int OriginalLisMaximumBodyBytes = 1048576;
+constexpr int OriginalLisMaximumTextCodeUnits = 1048576;
+constexpr int OriginalLisMaximumSegments = 64;
+constexpr int OriginalLisMaximumFieldsPerSegment = 128;
+constexpr int OriginalLisMaximumProjectItems = 4096;
+
+// 输入必须来自现有传输的完整ReceivedMessage，text已经按原配置解码、去MLLP边界。
+// 原业务先核消息头，再定位孔/判状态/置R1，最后才读DSR正文；两个阶段不能合成保存成功bool。
+// 本函数不选择当前连接，sequenceNumberSnapshot必须由调用方按原配置身份提供。
+OriginalLisReplyHeader decodeOriginalLisReplyHeader(const ReceivedMessage &message,
+                                                   const QString &sequenceNumberSnapshot);
+OriginalLisDsrFields decodeOriginalLisDsrFields(const OriginalLisReplyHeader &header);
+}
+#endif
diff --git a/06_programs/sn100_host/lis_business/original_lis_download_types.h b/06_programs/sn100_host/lis_business/original_lis_download_types.h
new file mode 100644
index 0000000..b025b57
--- /dev/null
+++ b/06_programs/sn100_host/lis_business/original_lis_download_types.h
@@ -0,0 +1,91 @@
+#ifndef SN100_ORIGINAL_LIS_DOWNLOAD_TYPES_H
+#define SN100_ORIGINAL_LIS_DOWNLOAD_TYPES_H
+
+#include "lis_transport/lis_connection_values.h"
+#include <QList>
+#include <QStringList>
+
+namespace Sn100Lis
+{
+// 这里只保存原消息的值，不是患者记录、孔位、任务或成功保存回执。
+enum class OriginalLisReplyKind { Other, Ack, Dsr };
+enum class OriginalLisHeaderState { Rejected, Ready };
+enum class OriginalLisDsrState { HeaderNotReady, NotDsr, NegativeResponse, Rejected, FieldsReady };
+
+struct OriginalLisFieldError
+{
+    QString field;
+    QString detail;
+};
+
+struct OriginalLisReplyHeader
+{
+    OriginalLisHeaderState state = OriginalLisHeaderState::Rejected;
+    OriginalLisReplyKind kind = OriginalLisReplyKind::Other;
+    ReceivedMessage source; // 原配置版本/令牌/指纹、generation、peer、body和text，不重贴新身份。
+    QString sequenceNumberSnapshot; // 调用方须提供与source.configuration对应的原配置值。
+    QStringList segments; // 原Message按CR/LF拆分并跳过空段后的文字。
+    QString sendingApplication; // MSH-3。
+    QString messageType; // MSH-9；原规则先contains(ACK)，再contains(DSR)。
+    QString controlId; // MSH-10；原定位依据，不是全局唯一ID。
+    QString version; // MSH-12。
+    QString applicationAcknowledgmentType; // MSH-16；保留原自定义样本标记，不改成标准推断。
+    QString responseCode; // MSA-1；DSR的OK/NF与上传AA不是同一阶段。
+    QString responseControlId; // MSA-2；原接收器读了它，但定位不用它。
+    OriginalLisFieldError error;
+};
+
+struct OriginalLisPatientFields
+{
+    QString patientIdentifier; // PID-3，仅原解析，不在DSR接收器保存。
+    QString bedNumber; // PID-4。
+    QString name; // PID-5。
+    QString wardAndRoom; // PID-6原串。
+    QString ward, room; // 恰好两个^分项才赋值；原接收器未保存。
+    QString sex; // PID-8，M/F/其他到枚举的转换留给后续原业务。
+    QString ageAndUnit; // 实际PID-30；原getPatientAge(31)内部减1。
+    QString age, ageUnit; // 恰好两个^分项才赋值；本片不做atoi或猜年龄单位。
+};
+
+struct OriginalLisOrderFields
+{
+    QString barcode; // OBR-2，不能与内部样本序号合并。
+    QString sampleNumber; // OBR-3；原Win32 toULong→int32转换尚不在本片执行。
+    QString urgent; // OBR-5，只解析，原接收器未采用。
+    QString registrationTime; // OBR-7；原无格式fromString，不在这里替换或补当前时间。
+    QString repeatTimes; // OBR-9原串；后续原业务toInt后小于1取1，没有99上限。
+    QString rackAndHole; // OBR-10原串，仅用于原日志，不能改成定位依据。
+    QString rack, hole; // 恰好两个^分项才赋值。
+    QString dilution; // OBR-12，只解析，原接收器未采用。
+    QString remark; // OBR-13。
+    QString specimenReceivedTime; // OBR-14，只解析，原接收器未采用。
+    QString specimenType; // OBR-15，只解析，原接收器未采用。
+    QString checker; // OBR-16。
+    QString department; // OBR-17。
+};
+
+struct OriginalLisDspProject
+{
+    QString code; // 未映射的原代码；不能直接当projectId或基础project_lis_code。
+    QString countText; // 最后一次成功stoi的原串，诊断保留，不改写为整数文字。
+    int count = 0; // 原DSP解析值；接收器实际建任务时不用它，而用OBR-9。
+};
+
+struct OriginalLisDsrFields
+{
+    OriginalLisDsrState state = OriginalLisDsrState::HeaderNotReady;
+    OriginalLisReplyHeader header;
+    OriginalLisPatientFields patient;
+    OriginalLisOrderFields order;
+    QString declaredProjectCount; // DSP-2原串，原读到但不核项目数量。
+    QString projectText; // DSP-3原串。
+    QList<OriginalLisDspProject> projects; // 原std::map<string>字节顺序，重复码取最后成功值。
+    int ignoredMalformedItems = 0;
+    int ignoredInvalidCounts = 0;
+    OriginalLisFieldError error;
+};
+}
+
+Q_DECLARE_METATYPE(Sn100Lis::OriginalLisReplyHeader)
+Q_DECLARE_METATYPE(Sn100Lis::OriginalLisDsrFields)
+#endif
diff --git a/06_programs/sn100_host/lis_business/original_lis_query.cpp b/06_programs/sn100_host/lis_business/original_lis_query.cpp
new file mode 100644
index 0000000..6ca89ad
--- /dev/null
+++ b/06_programs/sn100_host/lis_business/original_lis_query.cpp
@@ -0,0 +1,77 @@
+#include "original_lis_query.h"
+
+#include <QVector>
+
+namespace Sn100Lis
+{
+namespace
+{
+constexpr int MshLastField = 20;
+constexpr int QrdLastField = 19;
+constexpr int QrfLastField = 19;
+
+QString segmentText(const QVector<QString> &fields, int firstField)
+{
+    QString text = fields.at(0);
+    for (int field = firstField; field < fields.size(); ++field)
+    {
+        text += QChar('|');
+        text += fields.at(field);
+    }
+    text += QChar('\r');
+    return text;
+}
+}
+
+OriginalLisQuery buildOriginalLisQuery(QString rackId, int holeNumber,
+    const QString &sampleBarcode, const OriginalLisQueryTimes &times)
+{
+    OriginalLisQuery query;
+    // 原Windows/MinGW32的toULong及后续算术为32位无符号数。
+    // ARM64的unsigned long为64位，不能直接照写而改变失败/边界输入的结果。
+    const quint32 control = times.controlHhmmss.toUInt() * quint32(100) + quint32(holeNumber);
+    query.lisCode = QString::number(control);
+
+    // MSH是消息头：原构造补到20，序列化从2开始，字段1只表示分隔符。
+    QVector<QString> msh(MshLastField + 1);
+    msh[0] = QStringLiteral("MSH");
+    msh[1] = QStringLiteral("|");
+    msh[2] = QStringLiteral("^~\\&");
+    msh[7] = times.messageTimestamp;
+    msh[9] = QStringLiteral("QRY^Q02");
+    msh[10] = query.lisCode;
+    msh[11] = QStringLiteral("P");
+    msh[12] = QStringLiteral("2.3.1");
+    msh[16] = QStringLiteral("0");
+    msh[18] = QStringLiteral("UNICODE");
+
+    // QRD是查询条件：原查询不填写设备序列号，也不因急诊更改D/N/T。
+    QVector<QString> qrd(QrdLastField + 1);
+    qrd[0] = QStringLiteral("QRD");
+    qrd[1] = times.queryTimestamp;
+    qrd[2] = QStringLiteral("BC");
+    qrd[3] = QStringLiteral("D");
+    qrd[4] = query.lisCode;
+    qrd[7] = QStringLiteral("RD");
+    qrd[8] = sampleBarcode;
+    qrd[10] = QString::number(rackId.remove(0, 1).toInt()) + QChar('^') + QString::number(holeNumber);
+    qrd[11] = QStringLiteral("N");
+    qrd[12] = QStringLiteral("T");
+
+    // QRF是时间条件：沿原整数除乘取日首，不用日期库重新解释或修正文字。
+    const qulonglong dayStart = times.filterStartNow.toULongLong() / 1000000 * 1000000;
+    QVector<QString> qrf(QrfLastField + 1);
+    qrf[0] = QStringLiteral("QRF");
+    qrf[2] = QString::number(dayStart);
+    qrf[3] = times.filterEndNow;
+    qrf[6] = QStringLiteral("RCT");
+    qrf[7] = QStringLiteral("COR");
+    qrf[8] = QStringLiteral("ALL");
+
+    const QString body = segmentText(msh, 2) + segmentText(qrd, 1) + segmentText(qrf, 1);
+    // 原各字段toStdString后拼接，再fromStdString。保留同一UTF8往返，
+    // 不以QByteArray重载提前截断NUL，不擅加字段转义或MLLP边界。
+    query.body = QString::fromStdString(body.toStdString());
+    return query;
+}
+}
diff --git a/06_programs/sn100_host/lis_business/original_lis_query.h b/06_programs/sn100_host/lis_business/original_lis_query.h
new file mode 100644
index 0000000..ee1deeb
--- /dev/null
+++ b/06_programs/sn100_host/lis_business/original_lis_query.h
@@ -0,0 +1,32 @@
+#ifndef SN100_ORIGINAL_LIS_QUERY_H
+#define SN100_ORIGINAL_LIS_QUERY_H
+
+#include <QString>
+
+namespace Sn100Lis
+{
+// 原查询先后读取五次时钟，跨秒/跨日时可以不同；调用者按原顺序提供文字。
+// 本对象不读取系统时间，也不把五次取时合并成一次。
+struct OriginalLisQueryTimes
+{
+    QString controlHhmmss;       // 第一次：SystemCommon::getNow("%H%M%S")。
+    QString messageTimestamp;   // 第二次：MSH构造的yyyyMMddHHmmss.zzz本地时间。
+    QString queryTimestamp;     // 第三次：QRD构造的同格式本地时间。
+    QString filterStartNow;     // 第四次：getNow()的yyyyMMddHHmmss，原整数规则取日首。
+    QString filterEndNow;       // 第五次：另一次getNow()的yyyyMMddHHmmss，原样作为终点。
+};
+
+struct OriginalLisQuery
+{
+    QString body;               // 无MLLP头尾的正文；每段末尾保留CR，交传输层只封包一次。
+    QString lisCode;            // 原MSH-10/QRD-4控制号，不是传输层的递增请求编号。
+};
+
+// 对应原LisCommSetting::genLISFromSeverInfo的正文部分。
+// sampleBarcode是主控扫码条码，不是内部样本序号；此处不选孔、不校验状态、不置T1。
+// 保留原数字转换失败得到0的行为；调用者负责按原入口提供孔号和五个取时点。
+OriginalLisQuery buildOriginalLisQuery(QString rackId, int holeNumber,
+    const QString &sampleBarcode, const OriginalLisQueryTimes &times);
+}
+
+#endif
