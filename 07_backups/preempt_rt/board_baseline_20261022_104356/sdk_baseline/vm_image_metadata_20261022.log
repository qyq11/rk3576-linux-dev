SELECTED_BOARD_DEFCONFIG
############################################################
# Platform / Boot
############################################################
RK_UBOOT_SPL=y
RK_CHIP_FAMILY="rk3576"
RK_USE_FIT_IMG=y

############################################################
# Distribution
############################################################
RK_BUILDROOT=n
RK_DEBIAN=n
RK_UBUNTU=y
RK_UBUNTU_NOBLE=y
RK_UBUNTU_ARM64=y
RK_ROOTFS_SYSTEM="ubuntu"
RK_ROOTFS_SYSTEM_UBUNTU=y

############################################################
# Mirror
# Set the Ubuntu mirror to use for package downloads
# NOTE: Script will auto-append correct path based on arch
#       arm64 -> /ubuntu-ports, amd64 -> /ubuntu
#------------------------------------------------------------
## Ubuntu official mirrors:
#[1]ports.ubuntu.com (for ARM64)
#[2]archive.ubuntu.com (for x86/amd64)
#------------------------------------------------------------
## China mirrors:
#[1]mirrors.ustc.edu.cn
#[2]mirrors.tuna.tsinghua.edu.cn
#[3]mirrors.cloud.tencent.com
############################################################
#RK_UBUNTU_MIRROR="mirrors.ustc.edu.cn"
#RK_UBUNTU_MIRROR="mirrors.tuna.tsinghua.edu.cn"
#RK_UBUNTU_MIRROR="mirrors.cloud.tencent.com"
RK_UBUNTU_MIRROR="ports.ubuntu.com"

############################################################
# Building Recovery Source
# Your network is not able to access sources.buildroot.net!
# 403 Forbidden
# Enable the following configuration to disable the RECOVERY.
############################################################
RK_RECOVERY=n

############################################################
# Ubuntu Targets (Desktop/Server)
# Switch the desktop environment or use server (no GUI)
############################################################
RK_UBUNTU_TARGET="server"
RK_UBUNTU_TARGET_SERVER=y

############################################################
# Using SDIO Broadcom (AP6XXX) Modules
############################################################
RK_WIFIBT_MODULES="ALL_AP"

############################################################
# Using PCIe WiFi/Bluetooth (RTL8852BE) Modules
############################################################
# RK_WIFIBT_MODULES="RTL8852BE"
# RK_WIFIBT_CHIP="RTL8852BE"

############################################################
# GPU Driver Selection
# y = panfrost open-source driver (OpenGL 3.1 + GLES 3.1 + Vulkan 1.0)
# n = Mali closed-source DDK (GLES 3.2 only, no desktop OpenGL)
#
# Kernel defconfig and device tree are handled automatically
# via RK_KERNEL_CFG_FRAGMENTS and RK_KERNEL_DTS_NAME below.
############################################################
RK_GPU_PANFROST=y
RK_KERNEL_CFG_FRAGMENTS="rk3576_panfrost.config rk3576_server_console.config"
RK_KERNEL_DTS_NAME="tspi-3m-rk3576-panfrost"
