  "earlier_findings": [
    {
      "id": "CAL-GUARD-01",
      "status": "closed_in_source_and_private_store_evidence",
      "source": [
        "calibration_page.cpp:220-239,545-558",
        "calibration_store.cpp:1126-1179"
      ],
      "repair": "删除按钮同Save/Copy使用ready、idle、current project enabled和canEdit门槛；deleteCurrent在确认前检查已提交项目候选；remove在worker读取匹配revision/visible记录的project_id，再查当前catalog.is_used，停用/缺失不写visible。",
      "evidence": "store51日志含disabledProjectRemoveIsReadOnlyForRowsPointsAndHolds通过，reference22的停用项目用例也加remove拒绝；gate04 calShell6覆盖角色/草稿/保存/复制/隐藏等一般UI，不声称其另有停用删除按钮专项断言。",
      "retained": "启用项目仍只做revision检查后的软隐藏，点和项目/批次预约保留。停用项目历史读取/启动保护对账不受误禁。"
    },
    {
      "id": "CAL-GUARD-02",
      "status": "closed_for_same_catalog_canonical_path_binding_protocol",
      "source": [
        "calibration_store.cpp:337-370,378-460,462-540"
      ],
      "repair": "共享catalog预约事务先读取/登记catalog_metadata.calibration_dataset_path:<uuid>，值为规范本地DB文件路径。相同规范文件可多worker；另一文件同UUID不等时回滚并拒绝，不换UUID、不释放预约。",
      "evidence": "reference22已有sameCanonicalFileAllowsTwoWorkersAndSameBinding和sameUuidPhysicalCopyFailsClosedWithoutChangingIdentity；测试明确原文件关闭后真实QFile副本仍拒绝、旧UUID不变、原路径重开成功。",
      "scope": "限所有合作的新版本writer、同一catalog与规范路径协议。活库替换/raw SQLite/旧版本绕过不纳入保障；迁址、Windows/WSL/RK路径变更或克隆须显式授权迁移与预约对账。不能把它描述成可自动跨平台迁移数据库。"
    },
    {
      "id": "IRR-03 / prior unverified rollback cleanup boundary",
      "status": "covered_by_conservative_recovery_and_targeted_injection_evidence",
      "source": [
        "calibration_store.cpp:337-350,565-600,1023-1124"
      ],
      "repair": "QLockFile覆盖完整两库动作而非依赖SQLite旧事务仍存在。失败先rollback旧状态，再仍持操作锁重拿BEGIN IMMEDIATE，读所有已持久project/batch身份（不排除hidden），只释放本次新增且实际无人使用的键。重新锁、读取、释放失败均保留预约并带诊断，不对既有/他dataset/QC键清理。",
      "evidence": "reference22增加真实RAISE(ROLLBACK)及有限rollback_hook闸门，第二worker被操作锁拒绝、显式重试成功；catalog DELETE ABORT模拟回收失败后保留预约，重开因孤立键闭锁。",
      "boundary": "这些是已提供的错误注入与只读核验，不推定实板掉电、所有磁盘I/O失败或长稳均已验证。"
    }
  ],
  "unchanged_contracts": [
    "canEdit仍为authenticated && actionReady && role1..5，Guest和动作未就绪拒绝；所有普通写入口仍经worker check。",
    "原始点有限数、四位小数、顺序/重复浓度规则和两轴单位/ratio来源不变；既有记录身份不可重绑。当前单位变化不追溯换算旧值；缺Original/Calibration type或历史单位字典仍拒绝；save/copy仍要求项目启用。",
    "copy只读取匹配revision的已保存可见来源，新本地id、sourceId、时间；不读取未保存编辑，不继承审核/应用效力。",
    "启动对账包含隐藏记录，保留历史预约；孤立预约保留并拒绝ready。两库仍不具有跨文件外键/一次原子提交。",
    "菜单3仍为原1751x968校准画布的QScrollArea；会话、已提交项目/批次、busy/草稿/登录/注销/退出守卫和close→quit/wait接线仍在。",
    "图形只含原始浓度-测试平均值散点，未执行拟合、变换、逆算或仪器测试波形；审核/重算/计算方法/两应用按钮继续禁用，is_checked/is_applied仍只能为0。"
  ],
