tty1_autologin.before.conf: OK
ttyFIQ0_autologin.before.conf: OK
tty1_password_login.conf: OK
ttyFIQ0_password_login.conf: OK
root P 2026-11-02 0 99999 7 -1
[effective_password_login_commands]
getty@tty1.service
{ path=/sbin/agetty ; argv[]=/sbin/agetty --noclear - $TERM ; ignore_errors=yes ; start_time=[n/a] ; stop_time=[n/a] ; pid=0 ; code=(null) ; status=0/0 }
serial-getty@ttyFIQ0.service
{ path=/sbin/agetty ; argv[]=/sbin/agetty --noclear ttyFIQ0 1500000 linux ; ignore_errors=yes ; start_time=[n/a] ; stop_time=[n/a] ; pid=0 ; code=(null) ; status=0/0 }
