diff --git a/06_programs/sn100_host/reagents/original_reagent_level.h b/06_programs/sn100_host/reagents/original_reagent_level.h
new file mode 100644
--- /dev/null
+++ b/06_programs/sn100_host/reagents/original_reagent_level.h
@@ -0,0 +1,93 @@
+#ifndef SN100_ORIGINAL_REAGENT_LEVEL_H
+#define SN100_ORIGINAL_REAGENT_LEVEL_H
+
+#include "reagents/original_reagent_repository.h"
+#include "projects/projects_store.h"
+#include "original_files/original_reagent_capacity.h"
+#include <functional>
+#include <limits>
+
+namespace OriginalLevels
+{
+enum class PacketKind { Reagent, SampleIgnored };
+enum class MaximumSource { Unknown, InitialBottleByName, ConfirmedUr, ManualHoleSave, FilledHole, ClearedHole };
+
+struct ReceivedPacket
+{
+    PacketKind kind = PacketKind::Reagent;
+    bool linuxNew = false;
+    QByteArray payload;
+    QList<QByteArray> rawFields;
+    QStringList fields;
+    QString hole, reagent, area, bottle, sendIndex;
+    QString reportedDiameter, reportedAngle, reportedVolume;
+    int needle = 0;
+    double rawHeightMm = std::numeric_limits<double>::quiet_NaN();
+};
+
+// 原控件的独立运行快照，不能从孔库max_ul或整数显示模型冒充。
+// 来源、三库版本及revision由提供者核实；Unknown/不可用时不允许N写库。
+struct CurrentHoleRuntime
+{
+    bool available = false;
+    QString root, hole, reagent, bottle, area, reagentType, state;
+    QString settingFingerprint, bottleFingerprint, informationFingerprint;
+    quint64 revision = 0;
+    MaximumSource maximumSource = MaximumSource::Unknown;
+    double maximumMicrolitres = std::numeric_limits<double>::quiet_NaN();
+    double amountMicrolitres = std::numeric_limits<double>::quiet_NaN();
+    double usedMicrolitres = std::numeric_limits<double>::quiet_NaN();
+};
+
+struct Context
+{
+    quint64 packetId = 0; // 本地接收序号，不是N.sendIndex或设备请求号。
+    quint64 connection = 0; // transport到达时的原代次，不在后台重贴当前代次。
+    quint64 permissionRevision = 0;
+    QString root, actualModel, configuredModel, themeFingerprint, protocolToken;
+    QString capacityRelativeFile, capacityFingerprint;
+    OriginalRuntime::ReagentCapacityFileState capacityFileState = OriginalRuntime::ReagentCapacityFileState::Unknown;
+    bool linuxNew = false;
+    int configuredPositions = 0, reportedPositions = 0, mainStatus = -1;
+    bool capacityCalibrationActive = false;
+};
+
+struct ProjectSnapshot
+{
+    bool orderVerified = false;
+    ProjectRecords records; // 原全部项目及每个试剂步骤，已按原加载顺序排列。
+    QMap<QString,QString> versions; // project/<原文件名>及实际用于排序的config.ini。
+};
+
+struct PreparedObservation
+{
+    Context context;
+    ReceivedPacket received;
+    CurrentHoleRuntime before, after;
+    OriginalReagentState observed;
+    ProjectSnapshot projects;
+    OriginalRuntime::ReagentCapacityInput capacityInput;
+    OriginalRuntime::ReagentCapacityResult capacity;
+    qint64 holeId = 0;
+    QString formulaText, amountText, previousUsedText, usedText;
+    int amountInteger = 0;
+    bool updateUsed = false;
+    ReagentTestCount selectedHoleTests;
+};
+
+bool decodePacket(const QByteArray &payload, bool linuxNew, ReceivedPacket *result, QString *message);
+// 沿原项目外层排序与project_reagent无ORDER BY读取；只读，不调用检测计算。
+bool readProjectSnapshot(const QString &root, ProjectSnapshot *result, QString *message);
+// 只准备换算和原字段/显示变化，不发送或写库；runtime及项目顺序未核实时明确拒绝。
+bool prepareObservation(const OriginalReagentState &state, const ReceivedPacket &packet,
+                        const Context &context, const CurrentHoleRuntime &runtime,
+                        const ProjectSnapshot &projects, PreparedObservation *result, QString *message);
+// 只写formula_level/amount_uL，以及非Testing时的used_ul；已提交事实与返回成功分开。
+bool saveObservation(const PreparedObservation &prepared, const std::function<bool()> &stillCurrent,
+                     bool *committed, QString *savedFingerprint, QString *message);
+}
+
+Q_DECLARE_METATYPE(OriginalLevels::Context)
+Q_DECLARE_METATYPE(OriginalLevels::CurrentHoleRuntime)
+
+#endif
diff --git a/06_programs/sn100_host/reagents/original_reagent_level_packet.cpp b/06_programs/sn100_host/reagents/original_reagent_level_packet.cpp
new file mode 100644
--- /dev/null
+++ b/06_programs/sn100_host/reagents/original_reagent_level_packet.cpp
@@ -0,0 +1,82 @@
+#include "original_reagent_level.h"
+#include "protocol/frame_codec.h"
+#include <QTextCodec>
+#include <cmath>
+
+namespace OriginalLevels
+{
+namespace
+{
+bool fail(QString *message, const QString &reason)
+{
+    if (message) *message=reason;
+    return false;
+}
+}
+
+bool decodePacket(const QByteArray &payload, bool linuxNew, ReceivedPacket *result, QString *message)
+{
+    if (message) message->clear();
+    if (!result) return fail(message,QStringLiteral("N液位返回的输出为空。"));
+    *result=ReceivedPacket();
+    if (payload.size()<2 || payload.size()>Sn100Protocol::kMaxMessageBytes || payload[0]!='N')
+        return fail(message,QStringLiteral("不是完整的顶层N液位返回，或超过原通信本地读取上限。"));
+    QTextCodec *utf8=QTextCodec::codecForName("UTF-8");
+    if (!utf8) return fail(message,QStringLiteral("UTF-8解码器不可用，未猜测N字段编码。"));
+    ReceivedPacket read;
+    read.linuxNew=linuxNew;
+    read.payload=payload;
+    for (int cursor=1;cursor<payload.size();)
+    {
+        if (payload[cursor++]!='[')
+            return fail(message,QStringLiteral("N液位返回字段缺少左括号或含尾随内容。"));
+        const int end=payload.indexOf(']',cursor);
+        if (end<cursor || end-cursor>4096 || read.rawFields.size()>=4096)
+            return fail(message,QStringLiteral("N液位返回字段不完整或超过本地读取上限。"));
+        const QByteArray raw=payload.mid(cursor,end-cursor);
+        for (unsigned char character : raw)
+            if (character<32 || character=='[')
+                return fail(message,QStringLiteral("N液位返回含控制字符或未定义的嵌套括号。"));
+        QTextCodec::ConverterState conversion;
+        const QString text=utf8->toUnicode(raw.constData(),raw.size(),&conversion);
+        if (conversion.invalidChars || conversion.remainingChars)
+            return fail(message,QStringLiteral("N液位返回字段不是完整有效的原UTF-8文字。"));
+        read.rawFields.append(raw);
+        read.fields.append(text);
+        cursor=end+1;
+    }
+    if (read.fields.isEmpty()) return fail(message,QStringLiteral("N液位返回没有孔位字段。"));
+    read.hole=read.fields[0];
+    // 原Sample按首项contains判断，不能把其架号/孔号解释成试剂的9或10字段。
+    if (read.hole.contains(QStringLiteral("Sample")))
+    {
+        if (read.fields.size()<4)
+            return fail(message,QStringLiteral("N样本液位返回少于原分支所需的4项，未进入试剂处理。"));
+        read.kind=PacketKind::SampleIgnored;
+        *result=read;
+        return true;
+    }
+    const int expected=linuxNew ? 10 : 9;
+    if (read.fields.size()!=expected)
+        return fail(message,QStringLiteral("N试剂液位字段数与已确认的新旧协议不符，未按长度猜测协议。"));
+    read.reagent=read.fields[1];
+    read.area=read.fields[2];
+    read.sendIndex=read.fields[4]; // 原含义未核实，保留原文，不作为设备请求号。
+    read.bottle=read.fields[5];
+    read.reportedDiameter=read.fields[6];
+    read.reportedAngle=read.fields[7];
+    if (linuxNew) read.reportedVolume=read.fields[8];
+    if (read.hole.isEmpty() || read.reagent.isEmpty() || read.area.isEmpty() || read.bottle.isEmpty())
+        return fail(message,QStringLiteral("N试剂液位缺少孔位、试剂、区域或瓶型身份。"));
+    bool needleOk=false, heightOk=false;
+    read.needle=read.fields[3].toInt(&needleOk);
+    read.rawHeightMm=read.fields[linuxNew ? 9 : 8].toDouble(&heightOk);
+    // 本接收切片仅开放实际确认的三根针；不改变纯容量函数的1/2/其余映射。
+    if (!needleOk || read.needle<1 || read.needle>3)
+        return fail(message,QStringLiteral("N针号不是已确认的1至3整数；本接收入口保护性拒绝，未改成默认样本针。"));
+    if (!heightOk || !std::isfinite(read.rawHeightMm) || read.rawHeightMm<0 || read.rawHeightMm>=0xff00)
+        return fail(message,QStringLiteral("N毫米高度无效或达到原错误高度标记，未改写为0后继续保存。"));
+    *result=read;
+    return true;
+}
+}
diff --git a/06_programs/sn100_host/reagents/original_reagent_level_model.cpp b/06_programs/sn100_host/reagents/original_reagent_level_model.cpp
new file mode 100644
--- /dev/null
+++ b/06_programs/sn100_host/reagents/original_reagent_level_model.cpp
@@ -0,0 +1,276 @@
+#include "original_reagent_level.h"
+#include <QRegularExpression>
+#include <QSet>
+#include <cmath>
+#include <limits>
+
+namespace OriginalLevels
+{
+namespace
+{
+const QString informationFile=QStringLiteral("db/userSet/reagent_Information.db");
+const QString bottleFile=QStringLiteral("db/systemInfo/reagent_Bottle_Type.db");
+const QString settingFile=QStringLiteral("db/userSet/reagent_Setting.db");
+
+bool fail(QString *message, const QString &reason)
+{
+    if (message) *message=reason;
+    return false;
+}
+
+bool finiteNumber(const QVariant &value, double *number)
+{
+    bool ok=false;
+    *number=value.toString().toDouble(&ok);
+    return ok && std::isfinite(*number);
+}
+
+QString canonicalArea(const QString &area)
+{
+    if (area==QStringLiteral("0") || area==QStringLiteral("s_area")) return QStringLiteral("s_area");
+    if (area==QStringLiteral("1") || area==QStringLiteral("r_area")) return QStringLiteral("r_area");
+    return QString();
+}
+
+QString canonicalBottle(const QString &bottle)
+{
+    const QStringList aliases{QStringLiteral("7mL"),QStringLiteral("10mL"),QStringLiteral("15mL"),
+                              QStringLiteral("30mL"),QStringLiteral("50mL")};
+    for (int i=0;i<aliases.size();++i) if (bottle==QString::number(i+1)) return aliases[i];
+    bool numeric=false;
+    bottle.toDouble(&numeric);
+    return numeric ? QString() : bottle;
+}
+
+bool knownMaximumSource(MaximumSource source)
+{
+    switch (source)
+    {
+    case MaximumSource::InitialBottleByName:
+    case MaximumSource::ConfirmedUr:
+    case MaximumSource::ManualHoleSave:
+    case MaximumSource::FilledHole:
+    case MaximumSource::ClearedHole: return true;
+    case MaximumSource::Unknown: return false;
+    }
+    return false;
+}
+
+bool samePacket(const ReceivedPacket &first, const ReceivedPacket &second)
+{
+    return first.kind==second.kind && first.linuxNew==second.linuxNew && first.payload==second.payload &&
+        first.rawFields==second.rawFields && first.fields==second.fields && first.hole==second.hole &&
+        first.reagent==second.reagent && first.area==second.area && first.bottle==second.bottle &&
+        first.sendIndex==second.sendIndex && first.reportedDiameter==second.reportedDiameter &&
+        first.reportedAngle==second.reportedAngle && first.reportedVolume==second.reportedVolume &&
+        first.needle==second.needle && first.rawHeightMm==second.rawHeightMm;
+}
+
+bool verifiedProjects(const ProjectSnapshot &projects, const QString &root, QString *message)
+{
+    if (!projects.orderVerified || projects.versions.value(QStringLiteral("config.ini")).isEmpty())
+        return fail(message,QStringLiteral("原项目步骤/项目顺序尚未核实，或排序配置版本缺失。"));
+    QSet<QString> files, names;
+    QSet<int> orders;
+    for (const auto &project : projects.records)
+    {
+        const QString key=QStringLiteral("project/")+project.originalFileName;
+        bool orderOk=false;
+        const int order=project.originalBaseValues.value(QStringLiteral("xuhao")).toInt(&orderOk);
+        if (project.originalRoot!=root || project.originalFileName.isEmpty() || files.contains(project.originalFileName) ||
+            project.originalFingerprint.isEmpty() || projects.versions.value(key)!=project.originalFingerprint ||
+            project.name.isEmpty() || project.originalBaseValues.value(QStringLiteral("project_en_name"))!=project.name ||
+            !orderOk || project.id!=order || names.contains(project.name) || orders.contains(order))
+            return fail(message,QStringLiteral("原项目快照的工作根、文件身份或版本不完整，未猜测项目用量。"));
+        files.insert(project.originalFileName);
+        names.insert(project.name); orders.insert(order);
+    }
+    return true;
+}
+
+double limitedDisplay(double amount, double maximum)
+{
+    // 对应原N界面的先上限、后下限判断，不把这个数当作数据库原探测量。
+    if (amount>maximum) return maximum;
+    if (amount<0) return 0;
+    return amount;
+}
+
+ReagentTestCount selectedTests(const ProjectSnapshot &projects, const QString &name,
+                              double amount, double minimum)
+{
+    ReagentTestCount result;
+    QString text;
+    for (const auto &project : projects.records)
+    {
+        for (const auto &step : project.advanced.reagents)
+            if (step.value(QStringLiteral("reagent_name"))==name)
+            {
+                text=step.value(QStringLiteral("reagent_amount_ul"));
+                break; // 原版每个项目只看首个同名步骤，空文字才接着看下一项目。
+            }
+        if (!text.isEmpty()) break;
+    }
+    double use=0;
+    if (!finiteNumber(text,&use) || use<=0)
+    {
+        result.reason=QStringLiteral("没有可确认的首个同名项目单次用量，剩余次数未知。匹配不到用量不等于0次。");
+        return result;
+    }
+    const double tests=std::floor((amount-minimum)/use);
+    if (!std::isfinite(tests) || tests>std::numeric_limits<int>::max())
+    {
+        result.reason=QStringLiteral("按原项目用量得到的次数超出整数范围，未截断显示。");
+        return result;
+    }
+    result.available=true;
+    result.tests=tests<=0 ? 0 : static_cast<int>(tests);
+    return result;
+}
+}
+
+bool prepareObservation(const OriginalReagentState &state, const ReceivedPacket &packet,
+                        const Context &context, const CurrentHoleRuntime &runtime,
+                        const ProjectSnapshot &projects, PreparedObservation *result, QString *message)
+{
+    if (message) message->clear();
+    if (!result) return fail(message,QStringLiteral("N液位准备结果输出为空。"));
+    *result=PreparedObservation();
+    if (!context.packetId || !context.connection || !context.permissionRevision || context.root.isEmpty() ||
+        context.actualModel.isEmpty() || context.actualModel!=context.configuredModel || context.themeFingerprint.isEmpty() ||
+        context.linuxNew!=(context.protocolToken==QStringLiteral("LinuxNew")) ||
+        (context.configuredPositions!=20 && context.configuredPositions!=42) ||
+        context.configuredPositions!=context.reportedPositions || context.mainStatus<0 || context.mainStatus>6 ||
+        context.capacityCalibrationActive)
+        return fail(message,QStringLiteral("N到达连接、许可、机型、20/42孔配置、当前状态或标定模式尚未核实。"));
+    const QString expectedTable=context.configuredPositions==20 ? QStringLiteral("reagent_setting") : QStringLiteral("reagent_setting_6600");
+    if (state.root!=context.root || state.settingTable!=expectedTable || runtime.root!=context.root ||
+        packet.linuxNew!=context.linuxNew)
+        return fail(message,QStringLiteral("N快照工作根、原孔位表或新旧协议与接收上下文不一致。"));
+    ReceivedPacket verified;
+    if (!decodePacket(packet.payload,context.linuxNew,&verified,message)) return false;
+    if (verified.kind!=PacketKind::Reagent)
+        return fail(message,QStringLiteral("N样本液位已经分流，不进入试剂换算或保存。"));
+    if (!samePacket(packet,verified))
+        return fail(message,QStringLiteral("N已解析字段与保留的原报文不一致，未使用漂移的输入。"));
+    const QRegularExpression visible(context.configuredPositions==42 ?
+        QStringLiteral("^([A-F]_[1-7]|SD_[1-4])$") : QStringLiteral("^(R_([1-9]|1[0-9]|20)|SD_[1-4])$"));
+    if (!visible.match(packet.hole).hasMatch())
+        return fail(message,QStringLiteral("N孔位不属于当前实际20或42位页面，未处理表中额外行。"));
+    if (!runtime.available || !runtime.revision || !knownMaximumSource(runtime.maximumSource) ||
+        !std::isfinite(runtime.maximumMicrolitres) || runtime.maximumMicrolitres<0 ||
+        runtime.maximumMicrolitres>std::numeric_limits<int>::max() ||
+        !std::isfinite(runtime.amountMicrolitres) || !std::isfinite(runtime.usedMicrolitres))
+        return fail(message,QStringLiteral("本孔独立运行快照、最大量来源或版本未确认，不能借用孔库max_ul。"));
+    if (state.versions.value(informationFile).isEmpty() || state.versions.value(bottleFile).isEmpty() ||
+        state.versions.value(settingFile).isEmpty() ||
+        runtime.informationFingerprint!=state.versions.value(informationFile) ||
+        runtime.bottleFingerprint!=state.versions.value(bottleFile) ||
+        runtime.settingFingerprint!=state.versions.value(settingFile))
+        return fail(message,QStringLiteral("N运行快照与原试剂、瓶型、孔位三库版本不一致。"));
+    if (!verifiedProjects(projects,context.root,message)) return false;
+    const OriginalBusiness::Row *hole=nullptr;
+    for (const auto &row : state.holes)
+        if (row.value(QStringLiteral("hole_name")).toString()==packet.hole)
+        {
+            if (hole) return fail(message,QStringLiteral("原孔位表有重名孔，未合并N液位。"));
+            hole=&row;
+        }
+    if (!hole) return fail(message,QStringLiteral("N试剂孔位不存在于当前原孔位表。"));
+    bool idOk=false;
+    const qint64 holeId=hole->value(QStringLiteral("id")).toLongLong(&idOk);
+    const QString reagent=hole->value(QStringLiteral("reagent_name")).toString();
+    const QString bottle=hole->value(QStringLiteral("bottle_type")).toString();
+    const QString area=hole->value(QStringLiteral("area")).toString();
+    if (!idOk || holeId<=0 || !hole->contains(QStringLiteral("used_ul")) ||
+        reagent!=packet.reagent || bottle.isEmpty() || bottle!=canonicalBottle(packet.bottle) ||
+        area.isEmpty() || area!=canonicalArea(packet.area) ||
+        runtime.hole!=packet.hole || runtime.reagent!=reagent || runtime.bottle!=bottle || runtime.area!=area ||
+        runtime.reagentType!=hole->value(QStringLiteral("reagent_type")).toString())
+        return fail(message,QStringLiteral("N孔位、试剂、瓶型或区域与当前原库及独立运行快照不对应。"));
+    const QStringList states{QStringLiteral("r_none"),QStringLiteral("r_normal"),QStringLiteral("r_warning"),
+                              QStringLiteral("r_useout"),QStringLiteral("r_unknown"),QStringLiteral("r_outdate")};
+    if (!states.contains(runtime.state))
+        return fail(message,QStringLiteral("本孔当前界面状态未识别，未猜测N更新前状态。"));
+    const OriginalBusiness::Row *definition=nullptr, *geometry=nullptr;
+    for (const auto &row : state.reagents)
+        if (row.value(QStringLiteral("reagent_name")).toString()==reagent)
+        {
+            if (definition) return fail(message,QStringLiteral("原试剂资料存在重名定义，未猜测液量阈值。"));
+            definition=&row;
+        }
+    if (!definition) return fail(message,QStringLiteral("N当前试剂没有原reagent_list定义。"));
+    double out=0, warning=0;
+    if (!finiteNumber(definition->value(QStringLiteral("out_ul")),&out) ||
+        !finiteNumber(definition->value(QStringLiteral("warning_ul")),&warning))
+        return fail(message,QStringLiteral("当前原试剂的缺量或警告阈值不是有限数。"));
+    for (const auto &row : state.bottles)
+        if (row.value(QStringLiteral("bottle_type_name")).toString()==bottle && row.value(QStringLiteral("area")).toString()==area)
+        {
+            if (geometry) return fail(message,QStringLiteral("当前区域的原瓶型有重名资料，未猜测几何参数。"));
+            geometry=&row;
+        }
+    PreparedObservation prepared;
+    prepared.context=context; prepared.received=verified; prepared.before=runtime; prepared.after=runtime;
+    prepared.observed=state; prepared.projects=projects; prepared.holeId=holeId;
+    auto &input=prepared.capacityInput;
+    input.hole=packet.hole; input.needle=packet.needle; input.area=packet.area;
+    input.reportedBottle=packet.bottle; input.rawHeightMm=packet.rawHeightMm;
+    input.configuredBottle.hole=packet.hole; input.configuredBottle.name=bottle; input.configuredBottle.area=area;
+    input.configuredBottle.maximumMicrolitres=runtime.maximumMicrolitres;
+    // 几何缺项保持NaN；有效矩阵不需要它们，真正几何后备由v2明确检查。
+    double number=0;
+    if (geometry && finiteNumber(geometry->value(QStringLiteral("bottom_diameter")),&number))
+        input.configuredBottle.bottomDiameterMm=number;
+    if (geometry && finiteNumber(geometry->value(QStringLiteral("angle")),&number))
+        input.configuredBottle.angleDegrees=number;
+    if (!OriginalRuntime::calculateReagentCapacity(context.root,context.actualModel,input,&prepared.capacity,message)) return false;
+    if (context.capacityRelativeFile!=prepared.capacity.relativeFile || context.capacityFileState!=prepared.capacity.fileState ||
+        context.capacityFingerprint!=prepared.capacity.fingerprint)
+        return fail(message,QStringLiteral("N到达时绑定的容量资料状态或版本已变化，未给旧观测换用新参数。"));
+    const double measured=prepared.capacity.volumeMicrolitres;
+    if (!prepared.capacity.available || !std::isfinite(measured))
+        return fail(message,QStringLiteral("N容量结果不可用，未准备默认0液量。"));
+    prepared.formulaText=QString::number(packet.rawHeightMm);
+    prepared.amountText=QString::number(measured);
+    double stored=0;
+    if (!finiteNumber(prepared.amountText,&stored) || stored<std::numeric_limits<int>::min() || stored>std::numeric_limits<int>::max())
+        return fail(message,QStringLiteral("N原默认精度液量文本超出原整数amount_uL范围，未截断溢出。"));
+    prepared.amountInteger=static_cast<int>(stored);
+    prepared.previousUsedText=hole->value(QStringLiteral("used_ul")).toString();
+    prepared.updateUsed=context.mainStatus!=5;
+    prepared.usedText=prepared.updateUsed ? prepared.amountText : prepared.previousUsedText;
+    double displayed=measured;
+    if (!prepared.updateUsed)
+    {
+        // 原Testing从原探测量依次减所有项目每个同名步骤；不能再套assignTask扣量。
+        for (const auto &project : projects.records)
+            for (const auto &step : project.advanced.reagents)
+                if (step.value(QStringLiteral("reagent_name"))==reagent)
+                {
+                    double use=0;
+                    if (!finiteNumber(step.value(QStringLiteral("reagent_amount_ul")),&use) || use<0)
+                        return fail(message,QStringLiteral("测试态同名项目步骤用量无效，未猜测N界面扣量。"));
+                    displayed-=use;
+                    if (!std::isfinite(displayed)) return fail(message,QStringLiteral("测试态N界面扣量超出有限数范围。"));
+                    displayed=displayed>=0 ? displayed : 0.0;
+                }
+        displayed=limitedDisplay(displayed,runtime.maximumMicrolitres);
+        prepared.after.amountMicrolitres=displayed;
+        if (runtime.usedMicrolitres>displayed) prepared.after.usedMicrolitres=displayed;
+    }
+    else
+    {
+        displayed=limitedDisplay(displayed,runtime.maximumMicrolitres);
+        prepared.after.amountMicrolitres=displayed;
+        prepared.after.usedMicrolitres=displayed;
+    }
+    prepared.after.state=displayed<=out ? QStringLiteral("r_useout") :
+        displayed<=warning ? QStringLiteral("r_warning") : QStringLiteral("r_normal");
+    // 原N只重判控件状态；数据库state不在保存字段中，提交前不伪造新setting版本。
+    prepared.after.settingFingerprint.clear();
+    prepared.selectedHoleTests=selectedTests(projects,reagent,displayed,out);
+    *result=prepared;
+    return true;
+}
+}
diff --git a/06_programs/sn100_host/reagents/original_reagent_level_projects.cpp b/06_programs/sn100_host/reagents/original_reagent_level_projects.cpp
new file mode 100644
--- /dev/null
+++ b/06_programs/sn100_host/reagents/original_reagent_level_projects.cpp
@@ -0,0 +1,120 @@
+#include "original_reagent_level.h"
+#include "original_files/original_ini.h"
+#include "projects/original_project_repository.h"
+#include "projects/original_project_copy.h"
+#include <QDir>
+#include <QFileInfo>
+#include <QSqlError>
+#include <QSqlQuery>
+#include <QSqlRecord>
+#include <QSet>
+#include <algorithm>
+#include <limits>
+
+namespace OriginalLevels
+{
+namespace
+{
+bool fail(QString *message,const QString &reason)
+{
+    if (message) *message=reason;
+    return false;
+}
+}
+
+bool readProjectSnapshot(const QString &root,ProjectSnapshot *result,QString *message)
+{
+    if (!result) return fail(message,QStringLiteral("N项目快照输出为空。"));
+    *result=ProjectSnapshot();
+    if (!OriginalBusiness::workingRoot(root,message)) return false;
+    // 复制清单未解除时，不能把未提交或未知状态的克隆当成普通项目。
+    if (!OriginalProjectCopy::noPending(root,message)) return false;
+    ProjectSnapshot loaded;
+    const QString config=QDir(root).filePath(QStringLiteral("config.ini"));
+    const QString configVersion=OriginalProjectRepository::databaseFingerprint(config,message);
+    OriginalIni::Settings settings;
+    QString actualKey;
+    if (configVersion.isEmpty() || !OriginalIni::read(config,&settings,message) ||
+        !OriginalIni::resolveKey(settings,QStringLiteral("sendConfig/sendSequence"),&actualKey,message)) return false;
+    const QStringList sequence=actualKey.isEmpty() ? QStringList() : settings.values.value(actualKey).toStringList();
+    loaded.versions.insert(QStringLiteral("config.ini"),configVersion);
+    QDir directory(QDir(root).filePath(QStringLiteral("project")));
+    if (!directory.exists() || !directory.isReadable() || QFileInfo(directory.absolutePath()).isSymLink())
+        return fail(message,QStringLiteral("原项目目录不存在或为符号链接，未推定没有项目。"));
+    directory.setFilter(QDir::Files|QDir::NoSymLinks);
+    directory.setNameFilters({QStringLiteral("*.db")});
+    const QStringList listing=directory.entryList();
+    if (listing.size()>128) return fail(message,QStringLiteral("N所需项目清单超过128文件，未截断。"));
+    int totalSteps=0;
+    QSet<QString> projectNames;
+    QSet<int> projectOrders;
+    for (const QString &name : listing)
+    {
+        if (name.contains(QStringLiteral("formula"))) continue;
+        const QString relative=QStringLiteral("project/")+name;
+        const QString version=OriginalProjectRepository::databaseFingerprint(QDir(root).filePath(relative),message);
+        if (version.isEmpty()) return false;
+        OriginalBusiness::Database database;
+        if (!database.open(root,relative,false,message)) return false;
+        ProjectRecord project;
+        project.originalRoot=root; project.originalFileName=name; project.originalFingerprint=version;
+        QSqlQuery base(database.db);
+        if (!base.exec(QStringLiteral("SELECT name,value FROM project_base"))) return fail(message,base.lastError().text());
+        int baseRows=0;
+        while (base.next())
+        {
+            if (++baseRows>100000) return fail(message,QStringLiteral("原项目基础键超过读取上限。"));
+            const QString key=base.value(0).toString();
+            if (project.originalBaseValues.contains(key)) return fail(message,QStringLiteral("原项目基础键重复，未猜测优先值。"));
+            project.originalBaseValues.insert(key,base.value(1).toString());
+        }
+        if (base.lastError().isValid()) return fail(message,base.lastError().text());
+        project.name=project.originalBaseValues.value(QStringLiteral("project_en_name"));
+        bool orderOk=false;
+        const int order=project.originalBaseValues.value(QStringLiteral("xuhao")).toInt(&orderOk);
+        if (project.name.isEmpty() || !orderOk) return fail(message,QStringLiteral("原项目名称或xuhao顺序无效。"));
+        const QString nameIdentity=project.name;
+        if (projectNames.contains(nameIdentity) || projectOrders.contains(order))
+            return fail(message,QStringLiteral("N项目实际名称或xuhao重复，未按文件名区分克隆或重复扣显示量。"));
+        project.id=order;
+        projectNames.insert(nameIdentity); projectOrders.insert(order);
+        QSqlQuery steps(database.db);
+        // 原SqlBase::getData使用select *而无ORDER BY；不能复用另一读口的xuhao,rowid排序。
+        if (!steps.exec(QStringLiteral("SELECT * FROM project_reagent"))) return fail(message,steps.lastError().text());
+        const QSqlRecord columns=steps.record();
+        const int reagentColumn=columns.indexOf(QStringLiteral("reagent_name"));
+        const int amountColumn=columns.indexOf(QStringLiteral("reagent_amount_ul"));
+        if (reagentColumn<0 || amountColumn<0) return fail(message,QStringLiteral("原项目试剂表缺少名称或单次用量列。"));
+        while (steps.next())
+        {
+            if (++totalSteps>32768) return fail(message,QStringLiteral("N项目试剂步骤超过32768行，未截断。"));
+            ProjectActionFields step;
+            step.insert(QStringLiteral("reagent_name"),steps.value(reagentColumn).toString());
+            step.insert(QStringLiteral("reagent_amount_ul"),steps.value(amountColumn).toString());
+            project.advanced.reagents.append(step);
+        }
+        if (steps.lastError().isValid()) return fail(message,steps.lastError().text());
+        loaded.records.append(project); loaded.versions.insert(relative,version);
+    }
+    std::sort(loaded.records.begin(),loaded.records.end(),[](const ProjectRecord &a,const ProjectRecord &b)
+    { return a.originalBaseValues.value(QStringLiteral("xuhao")).toInt()<b.originalBaseValues.value(QStringLiteral("xuhao")).toInt(); });
+    if (!sequence.isEmpty())
+    {
+        const auto rank=[&sequence](const QString &name)
+        {
+            for (int i=0;i<sequence.size();++i) if (name.startsWith(sequence[i],Qt::CaseInsensitive)) return i;
+            return std::numeric_limits<int>::max();
+        };
+        std::stable_sort(loaded.records.begin(),loaded.records.end(),[&rank](const ProjectRecord &a,const ProjectRecord &b)
+        { return rank(a.name)<rank(b.name); });
+    }
+    if (listing!=directory.entryList()) return fail(message,QStringLiteral("读取N项目快照期间文件清单变化。"));
+    for (auto it=loaded.versions.cbegin();it!=loaded.versions.cend();++it)
+        if (it.value()!=OriginalProjectRepository::databaseFingerprint(QDir(root).filePath(it.key()),message))
+            return fail(message,QStringLiteral("读取N项目快照期间资料版本变化。"));
+    if (!OriginalProjectCopy::noPending(root,message)) return false;
+    loaded.orderVerified=true; // 表示按原SQL/排序读取，不代表已经做过实际设备运行核对。
+    *result=loaded;
+    return true;
+}
+}
diff --git a/06_programs/sn100_host/reagents/original_reagent_level_repository.cpp b/06_programs/sn100_host/reagents/original_reagent_level_repository.cpp
new file mode 100644
--- /dev/null
+++ b/06_programs/sn100_host/reagents/original_reagent_level_repository.cpp
@@ -0,0 +1,268 @@
+#include "original_reagent_level.h"
+#include "projects/original_project_repository.h"
+#include "projects/original_project_copy.h"
+#include "original_files/original_ini.h"
+#include <QDir>
+#include <QFileInfo>
+#include <QLockFile>
+#include <QSet>
+#include <cmath>
+
+namespace OriginalLevels
+{
+namespace
+{
+const QString informationFile=QStringLiteral("db/userSet/reagent_Information.db");
+const QString bottleFile=QStringLiteral("db/systemInfo/reagent_Bottle_Type.db");
+const QString settingFile=QStringLiteral("db/userSet/reagent_Setting.db");
+
+bool fail(QString *message, const QString &reason)
+{
+    if (message) *message=reason;
+    return false;
+}
+
+bool sameNumber(double first, double second)
+{
+    return first==second || (std::isnan(first) && std::isnan(second));
+}
+
+bool sameCapacity(const OriginalRuntime::ReagentCapacityResult &first,
+                  const OriginalRuntime::ReagentCapacityResult &second)
+{
+    return first.available && second.available && first.source==second.source &&
+        first.fileState==second.fileState && first.matrixState==second.matrixState &&
+        first.actualModel==second.actualModel && first.relativeFile==second.relativeFile &&
+        first.fingerprint==second.fingerprint && sameNumber(first.rawHeightMm,second.rawHeightMm) &&
+        first.quantizedHeightHundredths==second.quantizedHeightHundredths &&
+        sameNumber(first.quantizedHeightMm,second.quantizedHeightMm) &&
+        first.adjustedHeightAvailable==second.adjustedHeightAvailable &&
+        (!first.adjustedHeightAvailable || sameNumber(first.adjustedHeightMm,second.adjustedHeightMm)) &&
+        first.matrixMaximumMicrolitres==second.matrixMaximumMicrolitres &&
+        sameNumber(first.matrixVolumeMicrolitres,second.matrixVolumeMicrolitres) &&
+        sameNumber(first.volumeMicrolitres,second.volumeMicrolitres) &&
+        sameNumber(first.displayVolumeMicrolitres,second.displayVolumeMicrolitres);
+}
+
+bool sameCapacityInput(const OriginalRuntime::ReagentCapacityInput &first,
+                       const OriginalRuntime::ReagentCapacityInput &second)
+{
+    const auto &a=first.configuredBottle;
+    const auto &b=second.configuredBottle;
+    return first.hole==second.hole && first.needle==second.needle && first.area==second.area &&
+        first.reportedBottle==second.reportedBottle && sameNumber(first.rawHeightMm,second.rawHeightMm) &&
+        a.hole==b.hole && a.name==b.name && a.area==b.area &&
+        sameNumber(a.bottomDiameterMm,b.bottomDiameterMm) && sameNumber(a.angleDegrees,b.angleDegrees) &&
+        sameNumber(a.maximumMicrolitres,b.maximumMicrolitres);
+}
+
+bool sameRuntime(const CurrentHoleRuntime &first, const CurrentHoleRuntime &second)
+{
+    return first.available==second.available && first.root==second.root && first.hole==second.hole &&
+        first.reagent==second.reagent && first.bottle==second.bottle && first.area==second.area &&
+        first.reagentType==second.reagentType && first.state==second.state &&
+        first.settingFingerprint==second.settingFingerprint && first.bottleFingerprint==second.bottleFingerprint &&
+        first.informationFingerprint==second.informationFingerprint && first.revision==second.revision &&
+        first.maximumSource==second.maximumSource &&
+        sameNumber(first.maximumMicrolitres,second.maximumMicrolitres) &&
+        sameNumber(first.amountMicrolitres,second.amountMicrolitres) &&
+        sameNumber(first.usedMicrolitres,second.usedMicrolitres);
+}
+
+bool samePreparedResult(const PreparedObservation &first, const PreparedObservation &second)
+{
+    return first.holeId==second.holeId && first.formulaText==second.formulaText &&
+        first.amountText==second.amountText && first.amountInteger==second.amountInteger &&
+        first.previousUsedText==second.previousUsedText && first.usedText==second.usedText &&
+        first.updateUsed==second.updateUsed && sameCapacityInput(first.capacityInput,second.capacityInput) &&
+        sameCapacity(first.capacity,second.capacity) && sameRuntime(first.before,second.before) &&
+        sameRuntime(first.after,second.after) &&
+        first.selectedHoleTests.available==second.selectedHoleTests.available &&
+        first.selectedHoleTests.tests==second.selectedHoleTests.tests &&
+        first.selectedHoleTests.reason==second.selectedHoleTests.reason;
+}
+
+bool fingerprintMatches(const QString &root, const QString &relative, const QString &expected, QString *message)
+{
+    if (expected.isEmpty()) return fail(message,QStringLiteral("N保存缺少原文件版本：")+relative);
+    const QString current=OriginalProjectRepository::databaseFingerprint(QDir(root).filePath(relative),message);
+    if (current.isEmpty()) return false;
+    return current==expected || fail(message,QStringLiteral("N到达后原资料已变化，未用旧观测覆盖：")+relative);
+}
+
+bool themeMatches(const Context &context, QString *message)
+{
+    const QString file=QStringLiteral("theme_config.ini");
+    if (!fingerprintMatches(context.root,file,context.themeFingerprint,message)) return false;
+    OriginalIni::Settings settings;
+    QString modelKey, countKey;
+    if (!OriginalIni::read(QDir(context.root).filePath(file),&settings,message) ||
+        !OriginalIni::resolveKey(settings,QStringLiteral("theme/DriverModel"),&modelKey,message) ||
+        !OriginalIni::resolveKey(settings,QStringLiteral("theme/ReagentPanelChannelCount"),&countKey,message)) return false;
+    bool ok=false;
+    // 原仓库在缺孔数键时选择20位；机型仍须来自已经核实的显式主题值。
+    const int count=(countKey.isEmpty() ? QVariant(20) : settings.values.value(countKey)).toInt(&ok);
+    if (modelKey.isEmpty() || settings.values.value(modelKey).toString()!=context.configuredModel ||
+        !ok || count!=context.configuredPositions)
+        return fail(message,QStringLiteral("N对应的主题机型或试剂位配置已不一致，未选择其他表保存。"));
+    return fingerprintMatches(context.root,file,context.themeFingerprint,message);
+}
+
+bool projectsMatch(const PreparedObservation &prepared, QString *message)
+{
+    const auto &snapshot=prepared.projects;
+    const QString &root=prepared.context.root;
+    // 已持项目、试剂写锁；提交前的每次复核都不能绕过待核复制。
+    if (!OriginalProjectCopy::noPending(root,message)) return false;
+    if (!snapshot.orderVerified || snapshot.versions.value(QStringLiteral("config.ini")).isEmpty())
+        return fail(message,QStringLiteral("N保存缺少已核实的原项目顺序或排序配置版本。"));
+    QSet<QString> expectedFiles, expectedKeys, projectNames;
+    QSet<int> projectOrders;
+    expectedKeys.insert(QStringLiteral("config.ini"));
+    for (const auto &project : snapshot.records)
+    {
+        const QString file=project.originalFileName;
+        const QString key=QStringLiteral("project/")+file;
+        bool orderOk=false;
+        const int order=project.originalBaseValues.value(QStringLiteral("xuhao")).toInt(&orderOk);
+        if (file.isEmpty() || file!=QFileInfo(file).fileName() || file.contains('/') || file.contains('\\') ||
+            file.contains(QStringLiteral("formula")) || expectedFiles.contains(file) ||
+            project.originalRoot!=root || project.originalFingerprint.isEmpty() ||
+            snapshot.versions.value(key)!=project.originalFingerprint ||
+            project.name.isEmpty() || project.originalBaseValues.value(QStringLiteral("project_en_name"))!=project.name ||
+            !orderOk || project.id!=order || projectNames.contains(project.name) || projectOrders.contains(order))
+            return fail(message,QStringLiteral("N保存的原项目文件集合、工作根或文件版本不完整。"));
+        expectedFiles.insert(file);
+        expectedKeys.insert(key);
+        projectNames.insert(project.name); projectOrders.insert(order);
+    }
+    if (snapshot.versions.size()!=expectedKeys.size())
+        return fail(message,QStringLiteral("N项目版本表不对应本次完整项目集合，未忽略额外或缺失文件。"));
+    for (auto version=snapshot.versions.cbegin();version!=snapshot.versions.cend();++version)
+        if (!expectedKeys.contains(version.key()) || version.value().isEmpty())
+            return fail(message,QStringLiteral("N项目版本表包含未确认的路径或空版本。"));
+
+    const QString directoryPath=QDir(root).filePath(QStringLiteral("project"));
+    const QFileInfo directoryInfo(directoryPath);
+    const QDir directory(directoryPath);
+    if (directoryInfo.isSymLink() || !directoryInfo.isDir() || !directory.isReadable())
+        return fail(message,QStringLiteral("原项目目录不可读或类型不符，未把读取失败当作空项目集合。"));
+    QSet<QString> actualFiles;
+    // 与原loadAllProject一致：仅*.db普通文件、排除符号链接和formula专用库。
+    const QStringList entries=directory.entryList({QStringLiteral("*.db")},QDir::Files|QDir::NoSymLinks,QDir::Name);
+    for (const auto &file : entries)
+        if (!file.contains(QStringLiteral("formula"))) actualFiles.insert(file);
+    if (actualFiles!=expectedFiles)
+        return fail(message,QStringLiteral("N到达后原项目文件有增删，未沿用旧项目步骤或顺序保存。"));
+    for (auto version=snapshot.versions.cbegin();version!=snapshot.versions.cend();++version)
+        if (!fingerprintMatches(root,version.key(),version.value(),message)) return false;
+    return true;
+}
+
+bool capacityMatches(const PreparedObservation &prepared, QString *message)
+{
+    OriginalRuntime::ReagentCapacityResult current;
+    if (!OriginalRuntime::calculateReagentCapacity(prepared.context.root,prepared.context.actualModel,
+                                                   prepared.capacityInput,&current,message)) return false;
+    // 容量指纹是v2读取的原字节SHA，不能与包含SQLite旁文件的通用指纹混比。
+    if (!sameCapacity(prepared.capacity,current))
+        return fail(message,QStringLiteral("N准备后容量文件存在状态、版本或换算结果已变化，未改用其他模型保存。"));
+    return true;
+}
+}
+
+bool saveObservation(const PreparedObservation &prepared, const std::function<bool()> &stillCurrent,
+                     bool *committed, QString *savedFingerprint, QString *message)
+{
+    if (message) message->clear();
+    if (committed) *committed=false;
+    if (savedFingerprint) savedFingerprint->clear();
+    if (!committed || !savedFingerprint)
+        return fail(message,QStringLiteral("N保存的提交事实或保存指纹输出为空，未写入。"));
+    const auto &context=prepared.context;
+    const auto &observed=prepared.observed;
+    const QStringList files{informationFile,bottleFile,settingFile};
+    const QString table=context.configuredPositions==20 ? QStringLiteral("reagent_setting") : QStringLiteral("reagent_setting_6600");
+    if (!context.packetId || !context.connection || !context.permissionRevision || context.root.isEmpty() ||
+        !QDir::isAbsolutePath(context.root) || context.actualModel.isEmpty() ||
+        context.actualModel!=context.configuredModel || context.themeFingerprint.isEmpty() ||
+        (context.configuredPositions!=20 && context.configuredPositions!=42) ||
+        context.configuredPositions!=context.reportedPositions || context.mainStatus<0 || context.mainStatus>6 ||
+        context.capacityCalibrationActive || prepared.received.kind!=PacketKind::Reagent ||
+        prepared.received.linuxNew!=context.linuxNew || observed.root!=context.root || observed.settingTable!=table ||
+        observed.versions.size()!=files.size() || prepared.holeId<=0 ||
+        prepared.updateUsed!=(context.mainStatus!=5))
+        return fail(message,QStringLiteral("N保存的连接、原工作根、机型、状态、目标表或三库版本合同不完整。"));
+    for (const auto &file : files)
+        if (observed.versions.value(file).isEmpty())
+            return fail(message,QStringLiteral("N保存缺少到达时原库版本：")+file);
+    const auto permitted=[&]()
+    {
+        return (stillCurrent && stillCurrent()) ||
+            fail(message,QStringLiteral("N到达时的连接、运行快照或保存许可已失效，未继续写入。"));
+    };
+    const auto versionsMatch=[&](bool includeSetting)
+    {
+        if (!permitted()) return false;
+        for (const auto &file : files)
+            if ((includeSetting || file!=settingFile) &&
+                !fingerprintMatches(context.root,file,observed.versions.value(file),message)) return false;
+        if (!themeMatches(context,message) || !projectsMatch(prepared,message)) return false;
+        return permitted();
+    };
+    if (!permitted() || !OriginalBusiness::workingRoot(context.root,message)) return false;
+    QLockFile projectLock(QDir(context.root).filePath(QStringLiteral(".sn100-original-project-write.lock")));
+    QLockFile reagentLock(QDir(context.root).filePath(QStringLiteral(".sn100-original-reagent-write.lock")));
+    projectLock.setStaleLockTime(0); reagentLock.setStaleLockTime(0);
+    if (!projectLock.tryLock(0) || !reagentLock.tryLock(0))
+        return fail(message,QStringLiteral("原项目或试剂正在保存，N观测未覆盖当前操作。"));
+    if (!versionsMatch(true) || !capacityMatches(prepared,message)) return false;
+
+    OriginalBusiness::Database database;
+    if (!database.open(context.root,settingFile,true,message) || !database.begin(message)) return false;
+    const auto rollback=[&]() { database.rollback(); return false; };
+    if (!versionsMatch(true)) return rollback();
+    OriginalReagentRepository repository;
+    OriginalReagentState current;
+    if (!repository.initialize(context.root,message) || !repository.load(&current,message)) return rollback();
+    if (current.root!=context.root || current.settingTable!=table || current.versions!=observed.versions)
+    {
+        fail(message,QStringLiteral("进入N写事务后原试剂表或版本已变化，未保存旧观测。"));
+        return rollback();
+    }
+    PreparedObservation verified;
+    if (!prepareObservation(current,prepared.received,context,prepared.before,prepared.projects,&verified,message)) return rollback();
+    if (!samePreparedResult(prepared,verified))
+    {
+        fail(message,QStringLiteral("N事务内复核结果与准备时的字段、容量或运行快照不一致，未保存。"));
+        return rollback();
+    }
+    if (!versionsMatch(true)) return rollback();
+
+    // 原Table路径把默认精度液量文本转成整数amount_uL；used_ul仍保留原液量文本。
+    QString assignments=QStringLiteral("formula_level=?,amount_uL=?");
+    QVariantList arguments{verified.formulaText,verified.amountInteger};
+    if (verified.updateUsed)
+    {
+        assignments+=QStringLiteral(",used_ul=?");
+        arguments.append(verified.usedText);
+    }
+    arguments.append(verified.holeId);
+    arguments.append(verified.received.hole);
+    if (!database.execute(QStringLiteral("UPDATE \"%1\" SET %2 WHERE id=? AND hole_name=?").arg(table,assignments),
+                          arguments,message,1)) return rollback();
+    // 本事务已经改孔位库，提交前不把自身脏页当外部冲突；其他依赖继续核原版本。
+    if (!versionsMatch(false) || !capacityMatches(prepared,message) || !permitted()) return rollback();
+    if (!database.commit(message)) return rollback();
+    *committed=true;
+    database.db.close();
+    QString fingerprintError;
+    *savedFingerprint=OriginalProjectRepository::databaseFingerprint(QDir(context.root).filePath(settingFile),&fingerprintError);
+    if (savedFingerprint->isEmpty())
+        return fail(message,QStringLiteral("N观测已提交，但保存后的孔位指纹无法核对；不能按失败假定未写入：")+fingerprintError);
+    if (!stillCurrent || !stillCurrent())
+        return fail(message,QStringLiteral("N观测已提交，但连接或运行快照在提交期间变化，页面及当前设备结果仍待核对。"));
+    if (message) *message=QStringLiteral("N观测指定字段已提交并取得保存指纹，页面重读及运行快照更新另行核对；未发送设备命令。");
+    return true;
+}
+}
