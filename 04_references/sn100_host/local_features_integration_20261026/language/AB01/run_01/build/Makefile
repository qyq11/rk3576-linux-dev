install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/tests/hit_ab_preparation || mkdir -p $(INSTALL_ROOT)/usr/tests/hit_ab_preparation
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/tests/hit_ab_preparation/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/tests/hit_ab_preparation/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/tests/hit_ab_preparation/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/tests/hit_ab_preparation/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

