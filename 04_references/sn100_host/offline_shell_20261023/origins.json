{
  "module": "O03-1",
  "created": "2026-10-23",
  "reference_root": "06_programs/sn100_host_reference/Seerain450_PC",
  "scope": "Offline main shell and original user-settings container. Only existing O01 hospital page is instantiated. Reference project is read-only and was not built or executed.",
  "ownership": "frmMain owns frmUserSet and one hospital page; main owns HospitalStore and its worker. Switching never creates a second page or worker.",
  "visual_basis": {
    "main_ui": "1920x1080 original logical canvas and original widget tree retained",
    "user_ui": "1751x968 original editor canvas; QStackedWidget fits 1751x963 runtime area as original",
    "source_styles": [
      "frmmain/frmmain.cpp: constructor original menu, status and logo setup",
      "frmuserset/frmuserset.cpp: constructor original material buttons and CusView setup",
      "public/stylecolor.cpp: buttonStyle::setStrSheet()",
      "main.cpp: getConfig() visual key mapping and white font defaults"
    ],
    "visual_key_source": "bin/theme_config.ini (shipped visual fields only; never loaded at runtime)",
    "visual_keys": {
      "leftBaseColor": "28,28,28,255",
      "leftBtnColor": "232,51,35,200",
      "leftBtnFontColor": "255,255,255,255 (main.cpp default)",
      "rightBaseColor": "28,28,28,255",
      "rightBtnColor": "127,127,127,255",
      "rightBtnFontColor": "255,255,255,255 (main.cpp default)",
      "matchColor": "232,51,35,255",
      "LogoSize": "82x82"
    },
    "active_windows_theme": "Not verified: no original Windows runtime screenshot or active-release configuration baseline",
    "font": "Noto Sans CJK SC replacement; original PingFang runtime/font metrics remain to compare"
  },
  "differences": [
    "Reference .ui geometry, hierarchy and labels retained; original relative image paths become :/shell QRC resources. Main logo follows original runtime centering formula (43,18,82,82).",
    "Default main/user selection is 6/1 for authorized O01 slice rather than original 0/0; all other 7 main and 4 user pages have explicit disabled plain-text placeholders.",
    "No SystemCommon, TCP, LIS transport, algorithm, AccountStore, production login or instrument commands are created. Start/pause/shutdown/alarm/beeper/LIS/user/logout actions are disabled, state explicitly offline/unknown.",
    "One local clock timer only displays host time and performs no instrument synchronization.",
    "Hospital setEmbeddedInShell() restores original business panel position (330,10,801,551) and hides independent experiment footer; data-operation feedback uses the existing device-state label, prefixed offline, elided to its original width, retaining original normal text color and original theme red for errors. Complete detail is in status-area tooltips; instrument state remains unknown.",
    "Host requestLeave() handles initial/save busy rejection, unsaved confirmation and synchronous discard restoration; navigation cancellation restores original selection/focus. Window exit leaves worker shutdown to the main entry.",
    "CusMenuButton reuses lblInfo for start/pause rather than allocating an extra label, keeping the visible geometry and enabling correct disabled text. CusBadgeButton ignores mouse events while disabled. CusFlageImage cannot change offline status by clicking.",
    "Material FlatButton implementation, ripple and state-machine animation dependencies retained. Only unused systemcommon.h include removed and PingFang family replaced.",
    "Original CusMenuButton disabled label used invalid rgba(99,99,99) with no alpha; corrected to rgb(99,99,99), preserving the intended gray while removing the Qt QCssParser warning observed in the first WSL build/run. No geometry or business behavior changed.",
    "Existing 81px status label uses short offline outcomes (ready/busy/unsaved/failed), full reason in tooltip; no device state is fabricated.",
    "O01 host integration adds requestLeave() and setEmbeddedInShell(); standalone behavior retained. Linux discard dialog button minimum width includes CJK text, standard icon and padding to prevent clipping.",
    "Smaller screens use an external scroll host around the unchanged 1920x1080 canvas; physical-screen and complete scrollbar interaction remain to verify."
  ],
  "license": {
    "origin": "Vendor supplied reference source, customwidgets/materialUI; exact upstream/version not identified in this package",
    "preserved": "All source comments retained except unused systemcommon.h include; no copyright header existed in the copied subset",
    "notice": "Reference subset contains no code LICENSE. icons/LICENSE covers excluded icon collection, so it was not misapplied. External redistribution/license provenance remains to verify."
  },
