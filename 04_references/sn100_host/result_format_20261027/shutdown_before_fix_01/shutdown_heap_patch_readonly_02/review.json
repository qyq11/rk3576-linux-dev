  "checks": [
    {
      "topic": "HistoryPage relevant outbound notifications",
      "file": "06_programs/sn100_host/history/history_page.cpp",
      "lines": [
        539,
        550
      ],
      "conclusion": "Sets closing first, then detaches statusChanged and operationFinished emitted by Page before any owned-child teardown. This directly cuts the proven Page-to-dead-shell path; it does not claim to disconnect every incoming Store/app connection or every QObject.destroyed cleanup consumer."
    },
    {
      "topic": "HistoryPage State-to-Page inputs and one-time deletion",
      "file": "06_programs/sn100_host/history/history_page.cpp",
      "lines": [
        546,
        550
      ],
      "conclusion": "Reads the actual still-live QPointer, detaches this State sender to this Page receiver (cleared/destroyed included), then directly deletes the actual GUI-owned State and clears the live QPointer. No invalidateConfiguration call and no custom cleared/status emit is added. State has implicit/default destructor and value members; QObject teardown disconnects its remaining incoming Store/Project signals. Explicit deletion removes it from the parent child list, so QWidget base will not delete it again. State.destroyed cannot run the disconnected Page callback after derived members end."
    },
    {
      "topic": "Existing detail/UI teardown preserved",
      "file": "06_programs/sn100_host/history/history_page.cpp",
      "lines": [
        552,
        554
      ],
      "conclusion": "Existing detailDialog/detailUi/Ui deletion remains byte-identical after the new State teardown. The patch does not change active clearCurrentResultPresentation, source-closed/aboutToQuit behavior, requestLeave, patient drafts or real SQL operation handling."
    },
    {
      "topic": "ProjectPage destructor no longer invents a source-change event",
      "file": "06_programs/sn100_host/projects/project_page.cpp",
      "lines": [
        262,
        268
      ],
      "conclusion": "Removes destructor currentFormatInvalidated emit and detaches currentFormatInvalidated/statusChanged/operationFinished outputs. The actual commit/error/start/session invalidation connections outside the destructor remain byte-identical, so the normal current display contract is preserved."
    },
    {
      "topic": "Residual actual dialog ownership",
      "file": "06_programs/sn100_host/projects/project_page.cpp",
      "lines": [
        269,
        273
      ],
      "conclusion": "If the actual QPointer still names an owned ProjectFormatDialog, first detaches dialog-to-Page input callbacks, then deletes it while Page fields still exist and clears the live QPointer. Constructor still creates the dialog with parent=this. QObject deletion removes it from parent ownership and pending deferred-delete receiver events; it does not call the override accept/reject/save or fabricate a pending write ACK/Cancel. If finished previously cleared the QPointer, the old Qt parent ownership/deferred-delete mechanism remains; no additional second delete is introduced."
    },
    {
      "topic": "No normal guard or thread/lifecycle relaxation",
      "conclusion": "Byte comparison proves both C++ files differ only in their destructor bodies. No closeEvent/prepareToLeave/requestLeave/draft-confirm/save/readback/role/SQL/worker-join logic is changed. No new event pumping, timer, queued request, UI painting/status callback, or forced Store close is introduced. This is static scope verification, not post-patch runtime evidence."
    }
  ],
  "disconnect_directions": {
    "Page_specific_signal_to_any_receiver": "Outbound only; disconnects that Page emitted status/operation/current-format signal. Incoming Store/app callbacks are not thereby all disconnected.",
    "State_or_Dialog_to_Page": "Explicit sender-to-this input disconnection. Real owned child destruction also automatically tears down that child QObject connections.",
