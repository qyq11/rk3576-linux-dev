[group:dsi-display]
type    = group
name_zh = DSI 显示屏
name_en = DSI Display
desc_zh = MIPI DSI 接口屏幕，同一时间只能使用一个
desc_en = MIPI DSI display, only one can be active at a time

[tspi-3m-dsi-c41409463.dtbo]
enabled = false
name_zh = 10.1寸 MIPI 屏幕
name_en = 10.1" MIPI Display
desc_zh = LCKFB 10.1寸触摸屏 (800x1280, 4-lane MIPI, GT9xx触控, 立创编号:C41409463)
desc_en = LCKFB 10.1" Touchscreen (800x1280, 4-lane MIPI, GT9xx Touch, LCSC:C41409463)
group   = dsi-display

[tspi-3m-dsi-c42388916.dtbo]
enabled = false
name_zh = 3.1寸 MIPI 屏幕
name_en = 3.1" MIPI Display
desc_zh = LCKFB 3.1寸触摸屏 (480x800, 2-lane MIPI, CST128触控, 立创编号:C42388916)
desc_en = LCKFB 3.1" Touchscreen (480x800, 2-lane MIPI, CST128 Touch, LCSC:C42388916)
group   = dsi-display

[tspi-3m-can0-m2.dtbo]
enabled = true
name_zh = CAN0（40针7脚接收、11脚发送）
name_en = CAN0 M2 on header pins 7 and 11
desc_zh = 启用CAN0和7/11脚；通信速率另行设置，不自动收发
desc_en = `Enable CAN0 M2 only; bitrate and link startup are configured separately`

[tspi-3m-uart-header-five.dtbo]
enabled = true
name_zh = 40针排针五组串口
name_en = Five UARTs on 40-pin header
desc_zh = 启用UART3/4/7/8/9收发引脚；释放I2C7、I2C8和SPI1第二片选；外设参数及RS485方向另配
desc_en = `Enable UART3/4/7/8/9 TX and RX; release I2C7, I2C8 and SPI1 CS1; no serial data sent`

