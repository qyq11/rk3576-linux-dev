  "general_fields_source": "communication/commandreceiver.cpp:534-592；position不包含开头的GENERAL_COUNT。缺少的可选主字段在本地快照中保持缺少，不复用上次值或注入原全局默认配置。",
  "preserved": [
    "保留双向头尾、BE16长度、分包索引/总数、2000业务字节分片和数据字段XOR。",
    "保留Qj命令和方括号空字段，保留主状态/灯状态/错误类型的源码枚举编号及25字段顺序。",
    "保留顺序组包和错误可观测性；一次feed可解析连续多个合法线帧。",
    "普通布尔字段的正整数仍可表示真，不把源码toInt()>0误改为只能0或1。"
  ],
  "intentional_differences": [
    {
      "id": "D01-incomplete-timeout",
      "source": "10ms定时回调累计WAIT_COMPLETE_FRAME_TIMEOUT=1000后比较本次与上次缓冲长度；注释分别存在1秒/10000ms说法，且字节进展时未统一重置累计计数。原组包层没有独立明确的无进展期限。",
      "local": "使用调用者单调毫秒时钟，半帧自最后新字节、组包自最后新有效分片分别10秒无进展即清空；重复片不延长期限。任一超时丢弃同连接半帧和组包，断线reset也全部清空。",
      "reason": "时间口径明确、有界恢复；不宣称原固件确认了10秒等待策略。"
    },
    {
      "id": "D02-local-budgets",
      "local": {
        "max_packets": 64,
        "max_logical_bytes": 128000,
        "max_feed_bytes": 65536,
        "max_buffer_bytes": 67547,
        "business_fragment_bytes": [
          1,
          2000
        ],
        "status_general_count": [
          4,
          25
        ],
        "max_status_fields": 4096,
        "max_status_field_bytes": 1024,
        "max_subsystems": 64,
        "max_subsystem_fields": 256
      },
      "reason": "除源码2000分片值外均是本地资源/支持范围预算，不能当作仪器协议规格或全型号最大值。"
    },
    {
      "id": "D03-strict-atomic-status",
      "source": "原commandChanger提取括号字段后，pcQueryStatus直接toInt/at访问并逐字段修改全局状态；非法值可能变0、短报文可能越界。",
      "local": "仅支持可打印ASCII字段；验证完整括号、声明数量、已知枚举和相应非负数字字段；允许原布尔的正整数真值，负数/非法文本拒绝。完整验证后一次发布新快照，失败不发布部分状态。不执行原全局状态/UI副作用。",
      "reason": "拒绝把格式错误解释为成功状态，避免越界及半更新；未来固件新增字段/非ASCII文字需另行验证扩展。"
    },
    {
      "id": "D04-duplicate-and-correlation",
      "source": "帧层无请求ID；原组包仅依次检查index/total，没有完整消息身份或通用ACK重试契约。",
      "local": "只在未完成组包中跳过完全相同的前一个分片并计数；两个相同完整单包均作为新观测发布。一个Qj在途请求仅管理本地等待状态，不能证明任意回复属于哪次请求/重试。",
      "reason": "避免对自然重复状态误去重；不凭字节相同推定仪器重传。"
    },
    {
      "id": "D05-simulated-request-retry",
      "source": "所审CommandThread帧层没有Qj请求级自动重试/ACK超时表。",
      "local": "默认Qj等待1000ms、最多重试1次，只生成模拟TX字节；超限后状态标失效。构造参数限等待1..60000ms、重试0..3。事件时间推进可触发重试，实际发送时刻是当前模拟事件时间，不补发所有已错过周期。",
      "reason": "用于离线超时/恢复验证，不代表真实命令重发策略或仪器动作授权；真实Transport尚未接入。"
    },
    {
      "id": "D06-valid-status-silence",
      "source": "原CommandThread约每3秒按最后任意MCU数据/日志收包时间检查200000ms；lastRevLinkTime为空时不检查。",
      "local": "单调时间200000ms无有效Qj快照即模拟断线；从open计时，之后仅有效状态刷新。错误帧、日志或未知业务不能保持状态新鲜；receive/queryStatus先推进会话时间。",
      "reason": "缺首包或无效流量时也能清除旧状态；属于本地状态有效性策略，不是原样复制。"
    },
    {
      "id": "D07-no-automatic-followups",
      "source": "原pcQueryCmd每5次Qj回复emit signalSendTime；frmmain.cpp391接SendPCTime。原pcQueryStatus首次登录接收可请求试剂并安排配置检查。",
      "local": "不实例化原主窗、接收器、数据库或控制链，不发校时、试剂、配置、LIS或机械动作命令；模拟会话仅允许人工Qj查询与其本地模拟重试。",
      "reason": "切片只验证查询/状态协议，不扩大到写入或硬件功能。"
    },
    {
      "id": "D08-raw-subsystems",
      "source": "原pcQueryStatus按motorNumber分支解释SN450/其他型号传感器、通道与温度字段，并用motorOffset跳到下一块。",
      "local": "按[id][field_count][fields]核查边界，只保留原始子块；不把CV450/6600分支传感器映射声明为已核实的SN100字段，不将子块值驱动硬件/UI动作。",
      "reason": "机型/主控/协议版本及实际子系统布局尚待现场确认。"
    },
    {
      "id": "D09-frame-recovery",
      "source": "原拆帧噪声前缀remove(0,stxIndex+1)可能多删首字节；短包、队列和长度/超时处理缺少当前本地完整边界。",
      "local": "噪声重同步保留末尾首帧头字节；零/超长长度、错尾、错XOR、错序/总数和超预算均明确报错并有界丢弃，不照搬原越界/无界等待行为。",
      "reason": "保持合法线上格式，同时修复错误输入处理；错误路径变化需继续累计回归。"
    },
    {
      "id": "D10-event-driven-offline",
      "source": "原CommandThread在10ms轮询中每次取一发送包。",
      "local": "编解码器由调用者feed/expire驱动；encodeMessage只返回分帧列表，不使用真实发送队列或设定真实2000字节分包发送时序。回放器按合成事件推进。",
      "reason": "当前为可复用纯值协议边界和离线验证；未来Transport须单独核对板端发送时序、连接与背压。"
    }
  ],
