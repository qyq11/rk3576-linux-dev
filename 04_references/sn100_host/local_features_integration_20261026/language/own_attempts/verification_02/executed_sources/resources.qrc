<RCC>
    <qresource prefix="/image">
        <file alias="arrow_drop_down.svg">resources/arrow_drop_down.svg</file>
        <file alias="close.png">resources/close.png</file>
    </qresource>
    <qresource prefix="/messagebox">
        <file alias="message_info.png">resources/messagebox/message_info.png</file>
        <file alias="message_info_normal.png">resources/messagebox/message_info_normal.png</file>
        <file alias="message_info_hover.png">resources/messagebox/message_info_hover.png</file>
        <file alias="message_info_pressed.png">resources/messagebox/message_info_pressed.png</file>
        <file alias="message_ques.png">resources/messagebox/message_ques.png</file>
        <file alias="message_ques_normal.png">resources/messagebox/message_ques_normal.png</file>
        <file alias="message_ques_hover.png">resources/messagebox/message_ques_hover.png</file>
        <file alias="message_ques_pressed.png">resources/messagebox/message_ques_pressed.png</file>
        <file alias="message_warning.png">resources/messagebox/message_warning.png</file>
        <file alias="message_warn_normal.png">resources/messagebox/message_warn_normal.png</file>
        <file alias="message_warn_hover.png">resources/messagebox/message_warn_hover.png</file>
        <file alias="message_warn_pressed.png">resources/messagebox/message_warn_pressed.png</file>
        <file alias="message_error.png">resources/messagebox/message_error.png</file>
        <file alias="message_error_normal.png">resources/messagebox/message_error_normal.png</file>
        <file alias="message_error_hover.png">resources/messagebox/message_error_hover.png</file>
        <file alias="message_error_pressed.png">resources/messagebox/message_error_pressed.png</file>
    </qresource>
</RCC>
