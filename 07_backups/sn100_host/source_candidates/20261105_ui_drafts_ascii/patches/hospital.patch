+void frmHospInfoSetting::updateDirtyAfterRemoval()
+{
+    dirty_ = ui->ldtHospName->text() != displayedHospitalName_
+            || ui->tableInfo->rowCount() != displayedRows_.size();
+    for (int row = 0; !dirty_ && row < displayedRows_.size(); ++row)
+    {
+        const HospitalRow &saved = displayedRows_.at(row);
+        const auto *id = ui->tableInfo->item(row, 3);
+        const auto *one = qobject_cast<QLineEdit *>(ui->tableInfo->cellWidget(row, 0));
+        const auto *two = qobject_cast<QLineEdit *>(ui->tableInfo->cellWidget(row, 1));
+        const auto *three = qobject_cast<QLineEdit *>(ui->tableInfo->cellWidget(row, 2));
+        // 只比较输入，不走保存校验；尚未填好的新行也必须继续留在页面。
+        dirty_ = !id || !one || !two || !three || saved.id != id->text().toLongLong()
+                || saved.columnOne != one->text() || saved.columnTwo != two->text()
+                || saved.columnThree != three->text();
+    }
+}
